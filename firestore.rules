rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userExists() {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserProfile() {
      return userExists()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.uid == request.auth.uid;
    }

    // 🔒 THE adviser-authorisation check, mirroring utils/roles.js.
    //
    // It requires BOTH `role: "level_anchor"` AND `verificationStatus:
    // "verified"`. `role: "adviser"` is the value held by every UNVERIFIED
    // applicant, so testing that instead would hand the roster to anyone who
    // merely signed up. Requiring both also fails closed on a partial or
    // legacy profile that has one field but not the other.
    //
    // The `.get(key, default)` form is used because documents created before
    // Phase 3 have no role/verification keys at all, and touching a missing
    // key in a rules expression raises an ERROR (which denies) rather than
    // returning null.
    function isVerifiedAdviser() {
      return userExists()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('role', null) == 'level_anchor'
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('verificationStatus', null) == 'verified';
    }

    function isCourseRep(courseId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/courses/$(courseId)
        )
        && get(
          /databases/$(database)/documents/courses/$(courseId)
        ).data.repUid == request.auth.uid;
    }

    function isCourseMember(courseId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/courses/$(courseId)/members/$(request.auth.uid)
        );
    }

    function isCourseStaff(courseId) {
      return isCourseRep(courseId) || (
        isCourseMember(courseId)
        && get(
          /databases/$(database)/documents/courses/$(courseId)/members/$(request.auth.uid)
        ).data.role in ['assistant', 'session_assistant', 'rep']
      );
    }

    function validCourseFields() {
      return request.resource.data.repUid is string
        && request.resource.data.repUid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.institution is string
        && request.resource.data.institution.size() > 0
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.level is string
        && request.resource.data.level.size() > 0;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Profile create: students/reps carry a matric string; advisers carry
      // no matric (null) and instead write role/isAdviser/verificationStatus.
      //
      // 🔒🔒 SELF-PROMOTION IS BLOCKED HERE, NOT MERELY PINNED ON UPDATE.
      // Pinning role fields on `update` is necessary but NOT sufficient: a
      // brand-new document has no prior value to compare against, so a create
      // rule that only checks `matric is string` lets a tampered client mint
      // `role: "level_anchor" / verificationStatus: "verified"` outright. The
      // account would be born an anchor and never pass an email check.
      //
      // So a client-created profile is constrained to the unprivileged end of
      // the model. `level_anchor` / `verified` are absent from these lists on
      // purpose: they are values only api/verification.js may write, and it
      // runs on the Admin SDK, which bypasses these rules entirely.
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isRep is bool
        // Only the three roles a signup may legitimately request.
        && request.resource.data.get('role', 'student') in ['student', 'rep', 'adviser']
        // A client may never assert proof it has not made.
        && request.resource.data.get('verificationStatus', 'not_required') in ['not_required', 'pending_email']
        && request.resource.data.get('verifiedAt', null) == null
        && request.resource.data.get('verificationMethod', null) == null
        // 🔒 Nor roster standing. A client may not create itself as
        // roster-verified, and the server-owned provenance flags start empty
        // and are set by api/onboarding.js alone.
        && request.resource.data.get('rosterStatus', null) in [null, 'unverified']
        && request.resource.data.get('repGrantedByAdviser', null) in [null, false]
        // `isAdviser` must agree with `role`, so it cannot be used to smuggle
        // adviser-ness onto a student/rep document either.
        && request.resource.data.get('isAdviser', false) == (request.resource.data.get('role', 'student') == 'adviser')
        // 🔒 A client-supplied matric identifies a STUDENT. The adviser branch
        // must require the absence of one, not merely tolerate it — otherwise
        // the first branch below would let an adviser role ride in WITH a
        // matric and claim `matricRegistry` like any student.
        && (request.resource.data.get('role', 'student') == 'adviser'
            ? !(request.resource.data.matric is string)
            : (request.resource.data.matric is string && request.resource.data.matric.size() > 0))
        && (
          (
            request.resource.data.matric is string
            && request.resource.data.matric.size() > 0
            && request.resource.data.get('role', 'student') != 'adviser'
          )
          || (
            request.resource.data.get('role', '') == 'adviser'
            && request.resource.data.get('verificationStatus', '') == 'pending_email'
          )
        );

      // 🔒 Identity fields are immutable to the owner. `matric`, `isRep`,
      // `institution` and `department` define who this account IS inside the
      // trust chain and can never be rewritten from the client.
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.matric == resource.data.matric
        && request.resource.data.isRep == resource.data.isRep
        && request.resource.data.institution == resource.data.institution
        && request.resource.data.department == resource.data.department
        // 🔒🔒 ROLE + VERIFICATION ARE SERVER-OWNED. Without these pins any
        // signed-in user could open devtools and self-promote to
        // role: "level_anchor" / verificationStatus: "verified", bypassing the
        // adviser domain check and the one-adviser-per-level slot entirely.
        // Only api/verification.js may write these — it runs on the Admin SDK,
        // which bypasses firestore.rules. This is what keeps the trust chain
        // "Adviser verifies" honest, and it MUST stay in place before Phase 4
        // starts gating the adviser dashboard on `role`.
        //
        // These pins cover UPDATE only. The matching CREATE constraints are
        // above, and both halves are required: update pins stop an existing
        // account from climbing, create constraints stop a new one from being
        // born an anchor. utils/roles.js holds the canonical vocabulary so a
        // gate can never be written against the wrong value.
        // Each pin uses MapValue.get(key, default) rather than plain
        // `resource.data.x`. Documents created BEFORE Phase 3 have no
        // role/isAdviser/verificationStatus/verifiedAt/verificationMethod keys
        // at all, and touching a missing key in a rules expression raises an
        // ERROR that denies the whole request — that would lock every existing
        // user out of the settings form. With an explicit default, a legacy
        // document simply compares default-to-default and passes, while any
        // attempt to CHANGE a role field still fails the equality check.
        // 🔒 ROSTER STANDING IS SERVER-OWNED TOO. A student must not be able to
        // set `rosterStatus: "verified"` from the client to skip the check, nor
        // flip `repGrantedByAdviser` to claim a badge. Only api/onboarding.js
        // writes these, and it decides from the level roster.
        && request.resource.data.get('rosterStatus', null) == resource.data.get('rosterStatus', null)
        && request.resource.data.get('rosterReason', null) == resource.data.get('rosterReason', null)
        && request.resource.data.get('repGrantedByAdviser', null) == resource.data.get('repGrantedByAdviser', null)
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('isAdviser', false) == resource.data.get('isAdviser', false)
        && request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
        && request.resource.data.get('verifiedAt', null) == resource.data.get('verifiedAt', null)
        && request.resource.data.get('verificationMethod', null) == resource.data.get('verificationMethod', null);

      allow delete: if false;

      // 📲 FCM push tokens (device registrations for emergency alerts).
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // 🚩 Emergency push-style alerts (e.g. "flagged absent — see your Rep").
      // Written only by the trusted backend; the student can only read them.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /departmentReps/{repId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.repUid == request.auth.uid;
      allow update, delete: if isOwner(repId);
    }

    match /courses/{courseId} {
      allow read: if signedIn();

      allow create: if hasUserProfile() && validCourseFields();

      allow update: if isCourseStaff(courseId)
        && request.resource.data.repUid == resource.data.repUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.institution == resource.data.institution
        && request.resource.data.department == resource.data.department
        && request.resource.data.level == resource.data.level;

      allow delete: if isCourseRep(courseId);

      match /members/{memberUid} {
        // get (single doc): own doc or course staff
        // list (collection query / onSnapshot): any course member — needed for
        //   the live member listener that keeps enrolled counts in sync
        allow get: if signedIn() && (
          request.auth.uid == memberUid || isCourseStaff(courseId)
        );
        allow list: if isCourseMember(courseId) || isCourseStaff(courseId);

        // Normal student enrollment must be performed by the trusted backend.
        // The backend uses Firebase Admin credentials and bypasses client rules.
        allow create: if isCourseRep(courseId)
          && request.resource.data.uid == memberUid
          && request.resource.data.role in ['student', 'assistant', 'session_assistant', 'rep'];

        allow update: if isCourseRep(courseId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['student', 'assistant', 'session_assistant', 'rep']
          && (
            // 🎯 PROOF-OF-PRESENCE: appointing a session hotspot is only
            // legal while a live session exists AND the candidate has ALREADY
            // scanned in for it. The grantHotspot API enforces the same —
            // this rule closes the direct client-write path too. You cannot
            // scan the rep's screen from home, so an absent friend can never
            // be handed the rotating code.
            request.resource.data.role != 'session_assistant'
            || (
              exists(/databases/$(database)/documents/courses/$(courseId)/session/live)
              && get(/databases/$(database)/documents/courses/$(courseId)/session/secret).data.attendees.hasAny([resource.data.matric])
            )
          );

        allow delete: if isCourseRep(courseId)
          || (signedIn() && request.auth.uid == memberUid);
      }

      match /session/live {
        allow read: if signedIn() && (
          isCourseStaff(courseId) || isCourseMember(courseId)
        );
        allow create, update, delete: if isCourseStaff(courseId);
      }

      match /session/secret {
        // Assistants need to read the PIN during a live session.
        // Write is rep-only (they generate the session).
        allow read: if isCourseStaff(courseId);
        allow write: if isCourseRep(courseId);
      }

      match /attendance/{attendanceId} {
        // Closed-session summaries only (date + attendees[]).
        allow read: if isCourseStaff(courseId) || isCourseMember(courseId);
        allow write: if false;
      }

      match /checkins/{checkinId} {
        // Per-student live check-in rows. Kept separate from attendance/
        // so session-summary queries are not mixed with check-in shapes.
        allow read: if isCourseStaff(courseId) || isCourseMember(courseId);
        allow write: if false;
      }

      match /deviceFlags/{flagId} {
        allow read: if isCourseStaff(courseId);
        allow write: if false;
      }

      // 👥 GROUPS: sub-classes inside a parent course ("Group A", "Group B").
      // One session per lecture — groups only tag who belongs where. Staff
      // (rep + appointed assistants/group leads) manage groups; members stay
      // enrolled in the parent course and attendance history keeps the group
      // snapshot even after a group is deleted.
      match /groups/{groupId} {
        allow read: if signedIn() && (
          isCourseStaff(courseId) || isCourseMember(courseId)
        );
        allow create: if isCourseStaff(courseId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
        allow update: if isCourseStaff(courseId);
        allow delete: if isCourseRep(courseId);
      }

      // 🚩 Anti-beef absent flags. Written ONLY by the trusted backend
      // (Admin SDK) — never from a client. Staff can list every flag for
      // roster badges; a student can only ever read their OWN flag doc
      // (uid-keyed) — that is the emergency "see your Rep" alert. Flags are
      // permanent and can never be flipped or erased by anyone.
      match /absentFlags/{flagUid} {
        allow get: if isCourseStaff(courseId) || isOwner(flagUid);
        allow list: if isCourseStaff(courseId);
        allow create, update, delete: if false;
      }

      // Audit trail of student removals (backend-only, rep-readable).
      match /removalLog/{logId} {
        allow read: if isCourseStaff(courseId);
        allow write: if false;
      }

      // 📡 PUBLIC HOTSPOT LOG — transparency by design: every enrolled
      // student can see who was granted hotspot power, when, and by whom.
      // Written ONLY by the trusted backend (the grantHotspot API);
      // immutable from any client.
      match /hotspotLog/{logId} {
        allow read: if isCourseMember(courseId) || isCourseStaff(courseId);
        allow write: if false;
      }

      // Manual verification override requests (3-strike fail-safe).
      // Students can only create/edit their OWN pending request; the count of
      // automated failures is tracked client-side and is never stored/shown.
      // Only course staff can resolve a request — and the decision is final
      // (approved/rejected requests can never be flipped back to pending).
      match /manualRequests/{requestUid} {
        allow get: if signedIn() && (
          request.auth.uid == requestUid || isCourseStaff(courseId)
        );
        allow list: if isCourseStaff(courseId);

        allow create: if isOwner(requestUid)
          && request.resource.data.uid == requestUid
          && request.resource.data.status == 'pending'
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 200;

        allow update: if (
            // Student may refine their own reason while still pending...
            isOwner(requestUid)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.reason.size() <= 200
          ) || (
            // ...or, once the request's OWN session is over (the live
            // session is gone or is a different session), a decided
            // request no longer binds: the student can ask again for the
            // new session. The rep still must physically verify them —
            // approving into an expired session is impossible by design.
            isOwner(requestUid)
            && resource.data.status in ['approved', 'rejected']
            && (
              !exists(/databases/$(database)/documents/courses/$(courseId)/session/live)
              || get(/databases/$(database)/documents/courses/$(courseId)/session/live).data.expiresAt
                != resource.data.sessionExpiresAt
            )
            && request.resource.data.uid == requestUid
            && request.resource.data.status == 'pending'
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.reason.size() <= 200
          ) || (
            // ...but ONLY staff can resolve it, and only from pending.
            isCourseStaff(courseId)
            && resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected']
          );

        allow delete: if false;
      }

      // Holiday/Exemption management (rep-only writes).
      // 🛡️ PUBLIC by design: every enrolled student can LIST who is excused
      // on which dates (transparency — no quiet favours), while only the
      // affected student or staff can GET an individual doc. Private reasons
      // live in the staff-only exemptionReasons subcollection — never in the
      // public doc — and the anti-stuffing guards below stop a rep (or
      // anyone writing as rep) from pushing reason/details back into it.
      match /exemptions/{exemptionId} {
        allow get: if isCourseStaff(courseId) || (
          isCourseMember(courseId)
          && get(
            /databases/$(database)/documents/courses/$(courseId)/members/$(request.auth.uid)
          ).data.matric == resource.data.matric
        );
        allow list: if isCourseStaff(courseId) || isCourseMember(courseId);

        allow create: if isCourseRep(courseId)
          && request.resource.data.matric is string
          && request.resource.data.matric.size() > 0
          && request.resource.data.date is string
          && request.resource.data.date.size() > 0
          && !('reason' in request.resource.data)
          && !('details' in request.resource.data);

        allow update: if isCourseRep(courseId)
          && !('reason' in request.resource.data)
          && !('details' in request.resource.data);

        allow delete: if isCourseRep(courseId);
      }

      // 🔒 Exemption REASONS — staff-only. Written by the rep alongside the
      // public exemptions doc; never readable by course members, so private
      // medical/event details stay between the rep and the student.
      match /exemptionReasons/{exemptionId} {
        allow read: if isCourseStaff(courseId);
        allow create, update, delete: if isCourseStaff(courseId);
      }

      // 👁️ Session security events (screenshot attempts, leaving the app
      // mid-session). Soft signals — attendance itself is never written here.
      // A student can only ever create events attributed to themselves, and
      // only the rep/staff can read them. Nothing can be edited or erased.
      match /securityEvents/{eventId} {
        allow read: if isCourseStaff(courseId);
        allow create: if isCourseMember(courseId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['screenshot_attempt', 'left_app']
          && request.resource.data.sessionExpiresAt is number;
        allow update, delete: if false;
      }
    }

    // 🔒 MATRIC REGISTRY — server-written only. Maps "institution|matric" → uid.
    // Written exclusively by the trusted backend (Admin SDK bypasses rules);
    // clients can never forge a claim. Client reads are not needed — the
    // enrollment and claimMatric endpoints handle all checks server-side.
    match /matricRegistry/{registryKey} {
      allow read: if false;
      allow write: if false;
    }

    // DEPARTMENT ROSTERS - the adviser's imported level list (Phase 4).
    //
    // READ-ONLY TO CLIENTS, WITHOUT EXCEPTION. api/roster.js imports the CSV
    // and names the rep; it runs on the Admin SDK. There is deliberately no
    // "adviser writes this" rule here: the read that decides who may import
    // cannot itself be forged, and no client path can add a student to a
    // roster or hand the rep badge to itself.
    //
    // A roster entry is a matric the ADVISER asserts belongs to the level; it
    // grants no access to anything. Phase 5 links a chosen rep to a real
    // account separately.
    match /departmentRosters/{rosterId} {
      allow read: if isVerifiedAdviser();
      allow write: if false;
    }
  }
}
