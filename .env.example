# VeriPresenX — serverless environment template
#
# Copy to `.env` for local `vercel dev`, and add the same five keys in
# Vercel → Project → Settings → Environment Variables for production.
#
# `.env` is git-ignored (`.env*.local` is the ignored pattern, so `.env` itself
# is NOT ignored — do not commit it). The service-account JSON is separately
# blocked by `.gitignore` (`*firebase-adminsdk*.json`).

# ---------------------------------------------------------------------------
# Firebase Admin SDK — a FIRESTORE SERVICE ACCOUNT, not a web config.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# This credential bypasses firestore.rules entirely. Treat it as a master key.
# ---------------------------------------------------------------------------

# The Firebase project ID. MUST stay `attendify-4c93d` — the project ID is
# baked into stored document paths, Auth users and the deployed PWA. Changing
# it does not rename anything, it points the backend at a different database.
FIREBASE_PROJECT_ID=attendify-4c93d

# `client_email` from the service-account JSON.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@attendify-4c93d.iam.gserviceaccount.com

# `private_key` from the service-account JSON. Vercel env vars cannot hold real
# newlines, so paste it as a single line with literal \n escapes — the code
# normalises it with `.replace(/\\n/g, "\n")`. Include the BEGIN/END markers.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# CRON_SECRET authenticates /api/prune-advisers, which Vercel Cron calls daily
# at 03:00 UTC. Without it the endpoint answers 401 and nothing is pruned, so
# unverified adviser applications are never reclaimed.
#
# Any long random string. Vercel sends it as `Authorization: Bearer <value>`.
CRON_SECRET=your-long-random-string-here

# ---------------------------------------------------------------------------
# Feature flags — both default to OFF. Absence of the variable means OFF, so an
# unset value is safe; these are opt-in hardening switches.
# ---------------------------------------------------------------------------

# "true" turns App Check from a no-op into HARD MODE: every api/*.js request
# must carry a valid `x-firebase-appcheck` header or it is rejected with 401.
#
# ⚠️ Enabling this before the client is configured locks out every user.
#    app.js has `const APP_CHECK_SITE_KEY = ""` — while that is empty the
#    client sends no token, so hard mode rejects everything. Order of work:
#      1. Console → App Check → register the web app (reCAPTCHA v3)
#      2. paste the site key into APP_CHECK_SITE_KEY in app.js
#      3. confirm traffic shows as verified in the App Check dashboard
#      4. only then set ENFORCE_APP_CHECK=true
ENFORCE_APP_CHECK=false

# "true" makes `claimMatric` (api/account.js) refuse any ID token whose email
# is not verified, returning 403 + `emailNotVerified: true`.
REQUIRE_EMAIL_VERIFIED=false

# ---------------------------------------------------------------------------
# Adviser verification email (api/verification.js — Phase 3)
# ---------------------------------------------------------------------------
# api/verification.js mints a 6-digit code and emails it through Resend's HTTPS
# API. BOTH keys below are required for the adviser email-code path to actually
# deliver mail.
#
# ⚠️ If these are NOT set the endpoint still works but returns
#    delivery: "not_configured" — the code is created server-side and NO email
#    is sent, so the adviser has no way to complete verification. That is a
#    silent dead end, so set them before the pilot.
#
# RESEND_API_KEY — Resend dashboard → API Keys. Restricted to "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# VERIFICATION_FROM_EMAIL — must be a domain you have VERIFIED in Resend,
# otherwise every send bounces. Resend → Domains → Add Domain.
VERIFICATION_FROM_EMAIL=VeriPresenX <no-reply@your-verified-domain.com>

# ---------------------------------------------------------------------------
# NOT here, deliberately
# ---------------------------------------------------------------------------
# The Firebase WEB config (apiKey, authDomain, projectId, storageBucket,
# messagingSenderId, appId) is public by design and lives inline in app.js
# around line 373, plus firebase-messaging-sw.js. Those values ship to every
# browser; they are not secrets. Access control is firestore.rules + ID tokens.
#
# FCM_VAPID_KEY also lives in app.js (a public push key, not a secret).
